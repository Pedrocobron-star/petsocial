{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/share/:kind/:id",
      "destination": "https://aefrcwysifgniogumxwk.supabase.co/functions/v1/share-meta/share/:kind/:id"
    },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/offline.html", "destination": "/offline.html" },

    { "source": "/id/:token", "destination": "/id/[token].html" },
    { "source": "/endorse/:token", "destination": "/endorse/[token].html" },
    { "source": "/invite/:token", "destination": "/invite/[token].html" },
    { "source": "/post/:id", "destination": "/post/[id].html" },
    { "source": "/tag/:name", "destination": "/tag/[name].html" },
    { "source": "/adoption/:id", "destination": "/adoption/[id].html" },
    { "source": "/places/:id", "destination": "/places/[id].html" },
    { "source": "/chat/:id", "destination": "/chat/[id].html" },
    { "source": "/lost-found/:id", "destination": "/lost-found/[id].html" },
    { "source": "/meetup/:id/:sub", "destination": "/meetup/[id]/:sub.html" },
    { "source": "/meetup/:id", "destination": "/meetup/[id].html" },
    { "source": "/pet/:id/:sub", "destination": "/pet/[id]/:sub.html" },
    { "source": "/pet/:id", "destination": "/pet/[id].html" },
    { "source": "/admin/:section/:id", "destination": "/admin/:section/[id].html" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
