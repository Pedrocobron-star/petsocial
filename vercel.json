{
  "buildCommand": "npx expo export --platform web && node scripts/inject-og.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/share/:kind/:id",
      "destination": "https://aefrcwysifgniogumxwk.supabase.co/functions/v1/share-meta/share/:kind/:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://aefrcwysifgniogumxwk.supabase.co/functions/v1/share-meta/sitemap"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
