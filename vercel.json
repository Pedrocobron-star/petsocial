{
  "buildCommand": "npx expo export --platform web && node scripts/inject-og.mjs && node scripts/gen-sitemap.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "petsocial-tawny.vercel.app" }],
      "destination": "https://maestropet.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/share/:kind/:id",
      "destination": "https://aefrcwysifgniogumxwk.supabase.co/functions/v1/share-meta/share/:kind/:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
