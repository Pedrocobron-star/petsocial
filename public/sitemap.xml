<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap estático com rotas marketing/legais que merecem indexação.
  Rotas dinâmicas (/pet/{id}, /post/{id}, /id/{token}) NÃO entram aqui
  porque (a) os IDs são privados e (b) crawlers descobrem via shares e
  Open Graph nas próprias páginas.

  Caso queira indexar pets públicos, gerar sitemap-dynamic.xml via edge
  function (sitemap-feed) que consulta a tabela `pets` filtrando os que
  estão flag `is_public=true` — feature futura.
-->
